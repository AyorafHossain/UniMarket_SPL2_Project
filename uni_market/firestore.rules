rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is a verified NSTU student
    function isStudent() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@student[.]nstu[.]edu[.]bd');
    }

    // Check if the user is banned
    function isNotBanned() {
      return request.auth != null && 
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true);
    }

    // 1. Authenticated users can read products.
    // Sellers can update/delete only their own products.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if isStudent() && isNotBanned();
      allow update, delete: if isStudent() && isNotBanned() && resource.data.sellerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow read, write: if request.auth != null
          && request.auth.token.email.matches('.*@student\\.nstu\\.edu\\.bd$');
      }
    }

    // 2. Users can read/write only their own profile, cart, and wishlist
    // Support Tickets collection
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId && isStudent();
      allow create, update: if request.auth != null && request.auth.uid == userId && isStudent() && isNotBanned();

      match /wishlist/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /cart/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Wishlist items fallback collection (assuming global format from wishlist_service)
    match /wishlistItems/{itemId} {
      // Allow read/write for own items, or let productService read global items for pricing updates 
      // (Simplified to authenticated users for dev)
      allow read, write: if request.auth != null;
    }

    // 3. Authenticated users can access chats, orders, rentRequests, exchangeRequests, and notifications according to ownership.
    match /chat_rooms/{chatId} {
      allow read, write: if request.auth != null && 
                         (resource == null || request.auth.uid in resource.data.participantIds);
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null && 
                         (resource == null || request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
    }

    match /rentRequests/{requestId} {
      allow read: if request.auth != null && 
                         (resource == null || request.auth.uid == resource.data.renterId || request.auth.uid == resource.data.ownerId);
      allow write: if request.auth != null && isNotBanned() && 
                         (resource == null || request.auth.uid == resource.data.renterId || request.auth.uid == resource.data.ownerId);
    }

    match /exchangeRequests/{requestId} {
      allow read: if request.auth != null && 
                         (resource == null || request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.ownerId);
      allow write: if request.auth != null && isNotBanned() && 
                         (resource == null || request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.ownerId);
    }

    // Removed top-level reviews collection since it's a subcollection of products

    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && 
                         (resource == null || resource.data.userId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins via backend can write categories
    }
  }
}
